pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
t=0 --time
bc=15 --background color
sp=0.008 --speed
wl=1.5 --wellenlaenge
wa=3 --wellenamplitude
ty=  25 --text y pos
fmya= -4 --fm to ya
mxa=5 --max column dist
ssp= 16 --sfx speed
scs={8,9,12,13,14,8,9,12,13,14} --string colors
as=1 --act string
las=1 --last act string
ph = 0
 --phase
st = 0 --state
lst = 0 --last state
sn = 0 --sinus
fm = 0 --fast mod
sps = {} -- current sprites
str={
"spieleentwicklung",
"ist",
"pixelkunst",
"animation",
"storytelling",
"sounddesign",
"und",
"programmieren",
"mach mit!",
""
}


function _init()
 set_spd(8,ssp)
 music()
	set_tc(11)
end

function _update()
	t=t+sp
	sn=-(sin(ph))
	fm=(sin(t*2+0.25)+1)/2
	las=as
	as=(flr(ph*2)%#str)+1
	if t%1<0.25 or t%1>0.75 then 
		ph+=sp 
	end
	sps=buzuza(str[as])--sprites
	sc=scs[(as-1)%#scs+1]--sprite color
end

function _draw()
	cls(bc)
	local sx=1+abs(sn)/2--scale x
	local sy=1+abs(sn)/2	--scale y
	
	local xa=mxa*abs(sn)*sx --abstand x
	local xo=59-xa*#sps/2-(sx-1)*xa/8
	
	local ya=sn*(fm-0.5)*fmya --abstand y
	local yo=ty-#sps*ya/2--y-offset
	
	for i=1, #sps do
		local x=xo+xa*(i-0.5)
		local y=yo+ya*(i-0.5)+sin(wl/#sps*i+t*2)*wa

		local sprt=1 --sprite
		sprt=sps[i]
		
		local xa=(sprt-flr(sprt/16)*16)*8
		local ya=flr(sprt/16)*8
		sspr(xa,ya,8,8,x,y,sx*8,sy*8)
	end
	
	pal(12,sc,1)
	drw_scns()
end



-->8
--scenes

function drw_scns()
	if as==1 then 
	ty = 55
	end
	
	if as==2 then 
		if ty>25 then 
			ty=ty-0.2
		end
	end
	
	if as==3 then 
		spr(192,38,70,6,4)
		?"daniil",53,110,sc
	end
	if as==4 then 
		drw_flame(48,70)
		?"isranur",51,110,sc
	end
	
	if as==5 then
		if (as!=las) int_rotoma()
		drw_rotoma()
		?"lennox",53,110,sc
	end
	if as==6 then
		drw_wave()
	end
	if as==8 then
		sp=0.005 
		if ph%1>0.7 then
			?"if spielen < arbeit then",16,64,1
			?" spielen = spielen + 1"
			?" arbeit = arbeit - 1"
			?"end"
		end
	end
	if as>=9 then 
		sp=0.008 
		--bc=15 --background color
		--sp=0.01 --speed
		wl=4 --wellenlaenge
		wa+=0.2 --wellenamplitude
		ty=  50 --text y pos
		--fmya-=0.1  --fm to ya
		mxa+=0.05 --max column dist

	end
	
	if as==10 then
		sp=0.00 --speed
		music(-1)
		bc=0
		wl=0.5 --wellenlaenge
		wa+=1 --wellenamplitude
		ty=  50 --text y pos
		fmya=10  --fm to ya
		mxa+=0.1--max column dist
		if ph%1>0.9 then
		 --sp=0
		end
	end
end
-->8
function set_tc(c) --set transparen color
	for i=0,15 do palt(i,false) end
 palt(c,true)
end

function drw_wave()
 local y=73
 local w=90
 for i=0, w do 
 	local yo=sin(i/50+t*4)*10
 	pset((128-w)/2+i,y+yo,1)
 	pset((128-w)/2+i+1,y+yo+2,2)
 	pset((128-w)/2+i+2,y+yo+4,3)
 	pset((128-w)/2+i+3,y+yo+6,4)
 end
end

function drw_flame(x,y)
 sprts={64,68,72,76}
 frame=flr(time()* 5) % 4 + 1
 spr(sprts[frame],x,y,4,4)
end

function int_rotoma()
	rk_x = 43 --rotkaeppchen x position
	gm_x = 110 -- grossmutter x positi
	ro_t = 0
	rogm_y = 70
end

function drw_rotoma()

	ro_t=ro_t+0.05 
	if gm_x > 68 then 
 	gm_x=gm_x - 1.2 
 end 
 
	
	if ro_t<3 or ro_t>=3.5  then
	 spr(130,gm_x,rogm_y,2,4) 
	else
		spr(135,gm_x-8,rogm_y,3,4)
	end
	
	--rotkaeppchen
	if ro_t<4 then
	 spr(128,rk_x,rogm_y,2,4) 
	else
		spr(132,rk_x,rogm_y,3,4)
	end

end


function drw_debug()
	line(63,0,63,128,7)
	?"time: "..t
	?"state: "..st
	?"ph: "..ph
	?"as: "..as
	?"sn: "..sn
	?"fm: "..fm
end

function buzuza(txt) --buchstaben zu zahlen
 local werte = {}
	for i = 1, #txt do
	 local c = sub(txt, i, i)
	 code = ord(c)
	 -- groれか- und kleinbuchstaben behandeln
	 if code >= 65 and code <= 90 then
	  -- a-z ヌ●★ 0-25
	  add(werte, code - 64)
	 elseif code >= 97 and code <= 122 then
	  -- a-z ヌ●★ 0-25
	  add(werte, code - 96)
	 elseif code == 33 then
	 	--!
	 	add(werte,27)
	 else
	  -- sonst -1 (kein buchstabe)
	  add(werte, -1)
	 end
	end
 return werte
end

--audio functions
function mk_beat(idx)
	set_loop(btsfx,0,#beats[btord[idx]])
	for x=1,#beats[btord[idx]] do
		if beats[btord[idx]][x]==1 then
			set_note(btsfx,x-1,make_note(19,dumsfx+8,7,0))
		elseif beats[btord[idx]][x]==2 then
  			set_note(btsfx,x-1,make_note(18,taksfx+8,7,0))
  		elseif beats[btord[idx]][x]==0 then
  			set_note(btsfx,x-1,make_note(15,essfx+8,1,0))
		end
	end
	sfx(btsfx)
end

function spd2bpm(speed)
 bpm = 60 / (speed / (120 / 2))   
 return bpm
end

function make_note(pitch, instr, vol, effect)
 return { pitch + ((instr%4)<<6) , (instr\8<<7) + (effect<<4) + (vol<<1) + (instr%8)\4 }
 --{ iipppppp, ceeevvvi }
end

function get_note(sfx, time)
 local addr = 0x3200 + 68*sfx + 2*time
 return { peek(addr) , peek(addr + 1) }
end

function set_note(sfx, time, note)
 local addr = 0x3200 + 68*sfx + 2*time
 poke(addr, note[1])
 poke(addr+1, note[2])
end

function get_spd(sfx)
 return peek(0x3200 + 68*sfx + 65)
end

function set_spd(sfx, speed)
 poke(0x3200 + 68*sfx + 65, speed)
end

function set_loop(sfx, start, en)
 local addr = 0x3200 + 68*sfx
 poke(addr + 66, start)
 poke(addr + 67, en)
end
